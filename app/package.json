{
  "name": "@siglum/app",
  "version": "0.2.1",
  "description": "A LaTeX editor that runs entirely in your browser",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiglumProject/siglum-web"
  },
  "homepage": "https://siglum.org",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/prepareBrowserTools.ts && tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun scripts/test-isolated.ts",
    "build:local": "bun scripts/prepareBrowserTools.ts && tsc -b && vite build --mode local-preview",
    "preview:experimental": "node scripts/preview-experimental.mjs",
    "prepare:paragraph": "bun scripts/prepareParagraphRuntime.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.3",
    "@codemirror/view": "^6.39.6",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@siglum/engine": "^0.2.2",
    "@siglum/filesystem": "^0.3.1",
    "@siglum/git": "^0.1.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.2.0",
    "comlink": "^4.4.2",
    "idb": "^8.0.0",
    "isomorphic-git": "^1.36.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^2.1.3",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "15.11.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.6.0",
    "vite": "^7.1.2"
  },
  "private": true
}
